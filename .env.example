# loop-supervisor loads this file (as .env, via python-dotenv) before
# starting `opencode serve`, so any credential the configured provider or
# MCP servers need must be set here rather than assumed to already be in
# your shell.
#
# Required by puba itself, and doubles as the key opencode.json's "argo"
# provider uses (see README.md#environment and docs/configuration.md):
OPENAI_API_KEY=

# Recommended by puba (not required; requests are slower/less reliable
# without it — see docs/configuration.md#environment-variables):
OPENALEX_MAILTO=

# Required by opencode.json's "falda" MCP server (long-term agent memory):
FALDA_TOKEN=
