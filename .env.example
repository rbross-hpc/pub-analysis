# The default opencode backend uses credentials managed by OpenCode. Authenticate
# with `opencode providers login`; no LLM secret belongs in this file.
#
# If puba.config.yaml selects llm.backend: openai, set OPENAI_API_KEY and
# OPENAI_BASE_URL in this file or the environment.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Recommended by puba (not required; requests are slower/less reliable
# without it — see docs/configuration.md#environment-variables):
OPENALEX_MAILTO=
