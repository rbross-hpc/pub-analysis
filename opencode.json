{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "model": "argo/Claude Sonnet 5",
  "provider": {
    "argo": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Argo",
      "options": {
        "baseURL": "https://apps.inside.anl.gov/argoapi/v1/",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "Claude Sonnet 4.6": {
          "name": "Claude Sonnet 4.6"
        },
        "Claude Sonnet 5": {
          "name": "Claude Sonnet 5"
        },
        "Claude Opus 4.7": {
          "name": "Claude Opus 4.7"
        },
        "Claude Opus 4.8": {
          "name": "Claude Opus 4.8"
        },
        "GPT-5.6 Sol": {
          "name": "GPT-5.6 Sol"
        }
      }
    },
    "argo-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "Argo (Anthropic API)",
      "options": {
        "baseURL": "https://apps.inside.anl.gov/argoapi/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "claudesonnet5": {
          "name": "Claude Sonnet 5 (Anthropic API)"
        },
        "claudeopus48": {
          "name": "Claude Opus 4.8 (Anthropic API)"
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "*": "deny",
      "/workspaces/pub-analysis": "allow",
      "/workspaces/pub-analysis/**": "allow"
    },
    "doom_loop": "deny"
  },
  "mcp": {
    "falda": {
      "type": "remote",
      "url": "http://falda:8079/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:FALDA_TOKEN}",
        "X-Falda-Tenant": "puba-project"
      }
    }
  }
}
